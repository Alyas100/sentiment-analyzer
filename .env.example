# Sentiment engine: space (hosted HF Space, default) | hf (local checkpoint)
SENTIMENT_ENGINE=space

# Hosted Hugging Face Space serving the Gemma + LoRA Malay/Manglish fine-tune.
# The Space must expose an inference endpoint (see hf_space/app.py).
HF_SPACE_ID=alyaspronoob/malay-sentiment-demo

# Optional read token — gives the Space a higher ZeroGPU quota than anonymous calls.
# Never commit a token; keep it in your local .env only.
HF_TOKEN=

# Local Hugging Face checkpoint (used when SENTIMENT_ENGINE=hf).
# ModernBERT 150M, Apache-2.0, trained on 16 languages incl. Malay (ms) + Indonesian (id).
# Fetch it once into the project (git-ignored, ~290 MB):
#   hf download clapAI/modernBERT-base-multilingual-sentiment --local-dir models/modernbert-sentiment
# A Hub id also works (downloaded into the shared HF cache instead):
#   HF_SENTIMENT_MODEL=clapAI/modernBERT-base-multilingual-sentiment
HF_SENTIMENT_MODEL=models/modernbert-sentiment

# Inference device: auto | cpu | cuda | mps
# "auto" picks cuda > mps (Apple Silicon) > cpu. CPU-only is fully supported.
HF_DEVICE=auto

# Logging: DEBUG shows per-review model output, INFO shows engine selection
LOG_LEVEL=INFO

# Persistence
DATABASE_URL=sqlite:///data/sessions.db

# API
API_HOST=0.0.0.0
API_PORT=8000

# Guards
MAX_BATCH_ROWS=500
